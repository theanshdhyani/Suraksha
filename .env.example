# ==============================================================================
# SURAKSHA - Environment Configuration Template
# ==============================================================================
# Copy to .env for LIVE MODE or leave blank to run in full DEMO MODE.
# Never commit real credentials or expose server secrets to VITE_* variables.

# Server runtime
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Local / Lambda Approval Token Signing Secret (HMAC-SHA256)
# If omitted in DEMO MODE, an ephemeral cryptographic key is generated in memory.
APPROVAL_SIGNING_SECRET=

# Per-Service Mode Overrides (Optional: MOCK | LIVE)
# Leave blank for automatic detection based on available credentials.
SURAKSHA_STT_MODE=
SURAKSHA_TTS_MODE=
SURAKSHA_LLM_MODE=
SURAKSHA_SNS_MODE=
SURAKSHA_AUDIT_MODE=
SURAKSHA_GATEWAY_MODE=
SURAKSHA_THREAT_INTEL_MODE=

# ElevenLabs (Real-time Scribe v2 STT + Consented Family Voice TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# AWS Credentials (Optional if running on AWS IAM Role / Instance Profile / STS)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Amazon Bedrock (Explanation & Hindi/Hinglish family guidance ONLY)
BEDROCK_MODEL_ID=

# Amazon Cognito & Bedrock AgentCore Gateway
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AGENTCORE_GATEWAY_URL=

# Amazon SNS, DynamoDB & S3 Object Lock
SNS_TOPIC_ARN=
DYNAMODB_TABLE_NAME=
S3_AUDIT_BUCKET=

# Optional External Threat Intelligence API (e.g., Google Safe Browsing / PhishTank)
THREAT_INTEL_API_URL=
THREAT_INTEL_API_KEY=
